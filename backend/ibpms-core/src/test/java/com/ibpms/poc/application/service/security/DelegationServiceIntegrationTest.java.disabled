package com.ibpms.poc.application.service.security;

import com.ibpms.poc.AbstractIntegrationTest;
import com.ibpms.poc.application.dto.security.DelegationRequestDTO;
import com.ibpms.poc.infrastructure.jpa.entity.security.DelegationEntity;
import com.ibpms.poc.infrastructure.jpa.entity.security.UserEntity;
import com.ibpms.poc.infrastructure.jpa.repository.security.DelegationRepository;
import com.ibpms.poc.infrastructure.jpa.repository.security.UserRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;

import java.time.LocalDateTime;
import java.util.UUID;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

/**
 * US-036 CA-9 — Delegación Autónoma Temporal (Testcontainers)
 *
 * Certifica con PostgreSQL real (pgvector:pg16) que:
 * - CA-9 BE-01: Delegación válida se persiste correctamente
 * - CA-9 BE-02: startDate retroactiva lanza IllegalArgumentException
 * - CA-9 BE-03: Fechas invertidas (start >= end) lanzan IllegalArgumentException
 * - CA-9 BE-04: Donante inexistente lanza IllegalArgumentException
 * - CA-9 BE-05: Receptor inexistente lanza IllegalArgumentException
 * - CA-9 BE-06: Donante == Receptor lanza IllegalArgumentException
 * - CA-9 BE-07: La delegación creada es recuperable por JwtAuthFilter (findActiveDelegations)
 */
@DisplayName("US-036 CA-9 — DelegationService: Cesión Temporal de Poder")
class DelegationServiceIntegrationTest extends AbstractIntegrationTest {

    @Autowired
    private DelegationService delegationService;

    @Autowired
    private DelegationRepository delegationRepository;

    @Autowired
    private UserRepository userRepository;

    private UUID donorId;
    private UUID recipientId;

    @BeforeEach
    @SuppressWarnings("null")
    void setUp() {
        delegationRepository.deleteAll();
        userRepository.deleteAll();

        UserEntity donor = buildUser("donante@empresa.com");
        donorId = userRepository.save(donor).getId();

        UserEntity recipient = buildUser("receptor@empresa.com");
        recipientId = userRepository.save(recipient).getId();
    }

    // ─────────────────────────────────────────────
    // CA-9: Creación válida
    // ─────────────────────────────────────────────

    @Test
    @DisplayName("CA-9 RBAC-BE-13: delegación válida se persiste con todos los campos")
    void testCreateValidDelegation() {
        LocalDateTime start = LocalDateTime.now().plusHours(1);
        LocalDateTime end = LocalDateTime.now().plusDays(7);

        DelegationRequestDTO dto = buildDto(recipientId, start, end, "Vacaciones del donante");
        DelegationEntity saved = delegationService.createDelegation(donorId, dto);

        assertThat(saved.getId()).isNotNull();
        assertThat(saved.getDelegator().getId()).isEqualTo(donorId);
        assertThat(saved.getSubstitute().getId()).isEqualTo(recipientId);
        assertThat(saved.getReason()).isEqualTo("Vacaciones del donante");
        assertThat(saved.getIsActive()).isTrue();
    }

    // ─────────────────────────────────────────────
    // CA-9: Validación de fechas retroactivas
    // ─────────────────────────────────────────────

    @Test
    @DisplayName("CA-9 RBAC-BE-14: startDate retroactiva (>1 minuto en el pasado) lanza excepción")
    void testRetroactiveStartDateRejected() {
        LocalDateTime retroStart = LocalDateTime.now().minusMinutes(5);
        LocalDateTime end = LocalDateTime.now().plusDays(1);

        DelegationRequestDTO dto = buildDto(recipientId, retroStart, end, "intento retroactivo");

        assertThatThrownBy(() -> delegationService.createDelegation(donorId, dto))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessageContaining("retroactiva");
    }

    // ─────────────────────────────────────────────
    // CA-9: Validación de fechas invertidas
    // ─────────────────────────────────────────────

    @Test
    @DisplayName("CA-9 RBAC-BE-15: fechas invertidas (start >= end) lanzan excepción")
    void testInvertedDatesRejected() {
        LocalDateTime start = LocalDateTime.now().plusDays(3);
        LocalDateTime endBeforeStart = LocalDateTime.now().plusDays(1); // end ANTES de start

        DelegationRequestDTO dto = buildDto(recipientId, start, endBeforeStart, "fechas invertidas");

        assertThatThrownBy(() -> delegationService.createDelegation(donorId, dto))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessageContaining("anterior a la fecha de fin");
    }

    @Test
    @DisplayName("CA-9 RBAC-BE-16: start == end también es rechazado")
    void testEqualDatesRejected() {
        LocalDateTime instant = LocalDateTime.now().plusHours(2);

        DelegationRequestDTO dto = buildDto(recipientId, instant, instant, null);

        assertThatThrownBy(() -> delegationService.createDelegation(donorId, dto))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessageContaining("anterior a la fecha de fin");
    }

    // ─────────────────────────────────────────────
    // CA-9: Validación de usuarios inexistentes
    // ─────────────────────────────────────────────

    @Test
    @DisplayName("CA-9 RBAC-BE-17: donante inexistente lanza IllegalArgumentException")
    void testPhantomDonorRejected() {
        LocalDateTime start = LocalDateTime.now().plusHours(1);
        LocalDateTime end = start.plusDays(3);

        DelegationRequestDTO dto = buildDto(recipientId, start, end, null);

        assertThatThrownBy(() -> delegationService.createDelegation(UUID.randomUUID(), dto))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessageContaining("Donante no encontrado");
    }

    @Test
    @DisplayName("CA-9 RBAC-BE-18: receptor inexistente lanza IllegalArgumentException")
    void testPhantomRecipientRejected() {
        LocalDateTime start = LocalDateTime.now().plusHours(1);
        LocalDateTime end = start.plusDays(3);

        DelegationRequestDTO dto = buildDto(UUID.randomUUID(), start, end, null);

        assertThatThrownBy(() -> delegationService.createDelegation(donorId, dto))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessageContaining("Receptor no encontrado");
    }

    @Test
    @DisplayName("CA-9 RBAC-BE-19: donante == receptor lanza IllegalArgumentException")
    void testSelfDelegationRejected() {
        LocalDateTime start = LocalDateTime.now().plusHours(1);
        LocalDateTime end = start.plusDays(3);

        DelegationRequestDTO dto = buildDto(donorId, start, end, "auto-delegación ilegal");

        assertThatThrownBy(() -> delegationService.createDelegation(donorId, dto))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessageContaining("mismo usuario");
    }

    // ─────────────────────────────────────────────
    // CA-9: Integración con JwtAuthFilter (findActiveDelegations)
    // ─────────────────────────────────────────────

    @Test
    @SuppressWarnings("null")
    @DisplayName("CA-9 RBAC-BE-20: delegación activa es recuperable por findActiveDelegationsForSubstitute")
    void testActiveDelegationIsQueryable() {
        LocalDateTime start = LocalDateTime.now().minusSeconds(30); // ya activa
        LocalDateTime end = LocalDateTime.now().plusDays(1);

        // Bypass validación retroactiva para simular delegación ya en curso
        DelegationEntity delegation = new DelegationEntity(
                userRepository.findById(donorId).orElseThrow(),
                userRepository.findById(recipientId).orElseThrow(),
                start, end);
        delegation.setReason("delegación activa de integración");
        delegationRepository.save(delegation);

        var active = delegationRepository.findActiveDelegationsForSubstitute(recipientId, LocalDateTime.now());
        assertThat(active).hasSize(1);
        assertThat(active.get(0).getDelegator().getId()).isEqualTo(donorId);
    }

    // ─────────────────────────────────────────────
    // Helper
    // ─────────────────────────────────────────────

    private UserEntity buildUser(String email) {
        UserEntity u = new UserEntity();
        u.setUsername(email.split("@")[0]);
        u.setEmail(email);
        u.setPasswordHash("$2a$10$placeholder_hash");
        u.setIsActive(true);
        u.setIsExternalIdp(false);
        return u;
    }

    private DelegationRequestDTO buildDto(UUID recipientId, LocalDateTime start,
                                          LocalDateTime end, String reason) {
        DelegationRequestDTO dto = new DelegationRequestDTO();
        dto.setRecipientId(recipientId);
        dto.setStartDate(start);
        dto.setEndDate(end);
        dto.setReason(reason);
        return dto;
    }
}
